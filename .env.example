# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Everything here is server-only except the NEXT_PUBLIC_ Clerk values.

# Clerk (auth) — dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres — run `npm run db:push` once to create the tables
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Script — Google AI Studio API key
GEMINI_API_KEY=
# Optional: override when Google retires the default (see config/AiModel.ts)
GEMINI_MODEL=

# Voiceover — Google Cloud API key with the Text-to-Speech API enabled
TTS_API_KEY=

# Captions — AssemblyAI
ASSEMBLY_AI_API_KEY=

# Images — Replicate
REPLICATE_API_KEY=

# Storage — Firebase project settings → Service accounts → Generate new private key.
# Paste the JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
